# Copie para .env e preencha. NÃO faça commit do .env real.
# As chaves VITE_* são públicas (vão para o bundle do cliente) e protegidas por RLS.

# --- Supabase (obrigatório) ---
VITE_SUPABASE_URL="https://SEU_PROJECT_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-ou-publishable-key"
VITE_SUPABASE_PROJECT_ID="SEU_PROJECT_ID"

# Espelho server-side dos valores acima (SSR / middlewares).
SUPABASE_URL="https://SEU_PROJECT_ID.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sua-anon-ou-publishable-key"
SUPABASE_PROJECT_ID="SEU_PROJECT_ID"

# --- Somente no servidor (NUNCA no cliente, NUNCA no commit) ---
# Operações administrativas (bypass de RLS) em *.server.ts / server routes.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Supabase Auth / SMTP (usado por `supabase config push`, ver supabase/config.toml) ---
# Token pessoal da Supabase CLI para linkar/enviar config ao projeto hospedado (sbp_...).
SUPABASE_ACCESS_TOKEN=""
# URL base do app publicado (Site URL do Auth). Em dev: http://localhost:8080
SUPABASE_AUTH_SITE_URL="http://localhost:8080"
# URL de produção adicional para a allowlist de redirecionamento (opcional).
SUPABASE_AUTH_EXTRA_REDIRECT_URL=""
# Credenciais do provedor SMTP (ex.: Resend, SendGrid, Brevo, Amazon SES).
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""
# Remetente que aparece nos e-mails (precisa de domínio verificado no provedor).
SMTP_ADMIN_EMAIL=""

# --- IA (opcional; vazio = recursos de IA desligados, rotas /api/* respondem 503) ---
# Provedor compatível com a API /v1/responses e /v1/audio/* (estilo OpenAI).
AI_API_KEY=""
AI_GATEWAY_URL=""            # default interno se vazio; defina para usar seu provedor

# --- Analytics central / Codane Analytics (opcional; vazio = desligado) ---
# app_id e ingest_key vêm de supabase/registrar-apps.sql no repo codane-hub.
VITE_APP_ID=""
VITE_ANALYTICS_API_URL=""
VITE_ANALYTICS_INGEST_KEY=""

# --- Deploy (opcional) ---
# Alvo do build Nitro: node-server (default), cloudflare-module, vercel, etc.
NITRO_PRESET=""
# URL pública do app publicado — usada pelo WebView Android (capacitor.config.ts).
APP_PUBLIC_URL=""
